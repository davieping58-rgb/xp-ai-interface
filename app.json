{
  "expo": {
    "name": "XP",
    "slug": "xp-companion",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "fastshot",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.xp.companion",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "XP needs microphone access to hear your voice commands.",
        "NSCameraUsageDescription": "XP needs camera access for visual analysis when you ask him to look.",
        "NSPhotoLibraryUsageDescription": "XP needs photo library access to analyze images you share."
      }
    },
    "android": {
      "package": "com.xp.companion",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000814"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png",
      "backgroundColor": "#000814"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000814"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "XP needs microphone access to hear your voice commands."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}